{
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "tsx": "^4.19.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "@vitest/coverage-v8": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "name": "unified-music-api",
